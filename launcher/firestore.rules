rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email is string;
    }
    match /members/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['email', 'nickname', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'nickname', 'status', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nickname is string
        && request.resource.data.nickname.matches('^[A-Za-z0-9_]{3,16}$')
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nickname.lower())).data.uid == uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time;
      // Status changes and deletions are reserved for trusted administrators.
      allow update, delete: if false;
    }
    match /nicknames/{nickname} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if owner(request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.nickname.lower() == nickname;
      allow list, update, delete: if false;
    }
    function launcherAdmin() {
      return request.auth != null && owner(request.auth.uid)
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/launcherAdmins/$(request.auth.uid)).data.enabled == true;
    }
    match /launcherAdmins/{uid} {
      allow get: if owner(uid);
      allow list, create, update, delete: if false;
    }
    function validLauncherPack(d) {
      return d.keys().hasAll(['name','version','description','minecraft','forge','driveFileId','cover','published','serverAddress','sha256','archiveBytes','modCount','archivePrefix','java','forgeInstaller','updatedAt'])
        && d.keys().hasOnly(['name','version','description','minecraft','forge','driveFileId','cover','coverImage','showServer','published','serverAddress','sha256','archiveBytes','modCount','archivePrefix','java','forgeInstaller','updatedAt'])
        && (!('showServer' in d) || d.showServer is bool)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 64
        && d.version is string && d.version.size() > 0 && d.version.size() <= 40
        && d.description is string && d.description.size() <= 600
        && d.minecraft is string && d.minecraft.matches('^1[.][0-9]{1,2}([.][0-9]{1,2})?$')
        && d.forge is string && d.forge.matches('^[0-9]{1,3}([.][0-9]{1,4}){2,3}$')
        && d.driveFileId is string && d.driveFileId.matches('^[A-Za-z0-9_-]{10,150}$')
        && d.cover in ['citadel','forest'] && d.published is bool
        && (!('coverImage' in d) || (d.coverImage is string && d.coverImage.size() <= 180000 && d.coverImage.matches('^data:image/jpeg;base64,/9j/[A-Za-z0-9+/]*={0,2}$')))
        && d.serverAddress is string && d.serverAddress.size() <= 253
        && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$')
        && d.archiveBytes is int && d.archiveBytes > 0 && d.archiveBytes <= 12884901888
        && d.modCount is int && d.modCount > 0 && d.modCount <= 5000
        && d.archivePrefix is string && d.archivePrefix.size() <= 200
        && d.java is map && d.java.keys().hasAll(['version','url','sha256','expectedBytes','folder'])
        && d.java.keys().hasOnly(['version','url','sha256','expectedBytes','folder','major'])
        && d.java.url is string && d.java.url.size() < 600
        && d.java.sha256 is string && d.java.sha256.matches('^[a-f0-9]{64}$')
        && d.forgeInstaller is map && d.forgeInstaller.keys().hasAll(['url','sha256','expectedBytes'])
        && d.forgeInstaller.keys().hasOnly(['url','sha256','expectedBytes'])
        && d.forgeInstaller.url is string && d.forgeInstaller.url.size() < 600
        && d.forgeInstaller.sha256 is string && d.forgeInstaller.sha256.matches('^[a-f0-9]{64}$')
        && d.updatedAt is string && d.updatedAt.size() <= 40;
    }
    match /launcherAppearance/astral {
      allow get: if true;
      allow create, update: if launcherAdmin()
        && request.resource.data.keys().hasAll(['name','description','cover','updatedAt'])
        && request.resource.data.keys().hasOnly(['name','description','cover','coverImage','showServer','updatedAt'])
        && (!('showServer' in request.resource.data) || request.resource.data.showServer is bool)
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 64
        && request.resource.data.description is string && request.resource.data.description.size() <= 600
        && request.resource.data.cover in ['citadel','forest']
        && (!('coverImage' in request.resource.data) || (request.resource.data.coverImage is string && request.resource.data.coverImage.size() <= 180000 && request.resource.data.coverImage.matches('^data:image/jpeg;base64,/9j/[A-Za-z0-9+/]*={0,2}$')))
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
      allow list, delete: if false;
    }
    match /launcherPacks/{id} {
      // Catalog descriptions are public; only the trusted administrator can publish.
      allow get, list: if true;
      allow create, update: if id.matches('^[a-z0-9][a-z0-9-]{2,63}$')
        && launcherAdmin() && validLauncherPack(request.resource.data);
      allow delete: if id != 'astral' && launcherAdmin();
    }
    match /launcherContent/{id} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if launcherAdmin()
        && id.matches('^[a-z0-9][a-z0-9-]{2,63}-[a-f0-9]{16}$')
        && request.resource.data.keys().hasOnly(['manifest','revision','updatedAt'])
        && request.resource.data.manifest is string && request.resource.data.manifest.size() <= 650000
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40
        && ((!exists(/databases/$(database)/documents/launcherContent/$(id)) && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/launcherContent/$(id)) && request.resource.data.revision == resource.data.revision + 1));
    }
    match /minepassConfig/astral-local {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if launcherAdmin()
        && request.resource.data.keys().hasOnly(['config','revision','updatedAt'])
        && request.resource.data.config is string && request.resource.data.config.size() <= 600000
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40
        && ((!exists(/databases/$(database)/documents/minepassConfig/astral-local) && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/minepassConfig/astral-local) && request.resource.data.revision == resource.data.revision + 1));
    }

    match /launcherThemes/astral {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if launcherAdmin()
        && request.resource.data.keys().hasOnly(['config','revision','updatedAt'])
        && request.resource.data.config is string && request.resource.data.config.size() <= 220000
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40
        && ((!exists(/databases/$(database)/documents/launcherThemes/astral) && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/launcherThemes/astral) && request.resource.data.revision == resource.data.revision + 1));
    }
    match /siteStarFinders/{findingId} {
      allow get: if launcherAdmin() || (request.auth != null && findingId.matches('^' + request.auth.uid + '_[a-z0-9_]{3,16}$'));
      allow list: if launcherAdmin();
      allow update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','nickname','contact','foundAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.matches('^[A-Za-z0-9_]{3,16}$')
        && findingId == request.auth.uid + '_' + request.resource.data.nickname.lower()
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 80
        && request.resource.data.foundAt == request.time;
    }

    match /siteSecrets/{secretId} {
      allow get: if secretId == 'first-star';
      allow list, update, delete: if false;
      allow create: if secretId == 'first-star' && request.auth != null
        && request.resource.data.keys().hasOnly(['found','foundAt'])
        && request.resource.data.found == true
        && request.resource.data.foundAt == request.time
        && !exists(/databases/$(database)/documents/siteSecretWinners/$(secretId))
        && getAfter(/databases/$(database)/documents/siteSecretWinners/$(secretId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/siteSecretWinners/$(secretId)).data.foundAt == request.time;
    }
    match /siteSecretWinners/{secretId} {
      allow get: if secretId == 'first-star' && (launcherAdmin() || (request.auth != null && resource.data.uid == request.auth.uid));
      allow list, update, delete: if false;
      allow create: if secretId == 'first-star' && request.auth != null
        && request.resource.data.keys().hasOnly(['uid','nickname','contact','foundAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.matches('^[A-Za-z0-9_]{3,16}$')
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 80
        && request.resource.data.foundAt == request.time
        && !exists(/databases/$(database)/documents/siteSecrets/$(secretId))
        && getAfter(/databases/$(database)/documents/siteSecrets/$(secretId)).data.found == true
        && getAfter(/databases/$(database)/documents/siteSecrets/$(secretId)).data.foundAt == request.time;
    }

    match /nicknames/{nickname} {
      allow get: if launcherAdmin();
    }
    match /accountWallets/{uid} {
      allow get: if owner(uid) || launcherAdmin();
      allow list, delete: if false;
      allow create, update: if launcherAdmin()
        && request.resource.data.keys().hasOnly(['balance'])
        && request.resource.data.balance is int
        && request.resource.data.balance >= 0 && request.resource.data.balance <= 1000000000;
      match /history/{id} {
        allow get, list: if launcherAdmin();
        allow create: if launcherAdmin()
          && request.resource.data.keys().hasOnly(['before','after','reason','admin','createdAt'])
          && request.resource.data.before is int && request.resource.data.before >= 0
          && request.resource.data.after is int && request.resource.data.after >= 0 && request.resource.data.after <= 1000000000
          && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 200
          && request.resource.data.admin == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /accountSkins/{nickname} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if owner(request.auth.uid)
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.nickname.lower() == nickname
        && request.resource.data.keys().hasOnly(['uid','png','model'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.model in ['classic','slim']
        && request.resource.data.png is string && request.resource.data.png.size() <= 100000
        && request.resource.data.png.matches('^data:image/png;base64,[A-Za-z0-9+/]+=*$');
    }

    function cosmeticPurchase(uid, d) {
      let item = get(/databases/$(database)/documents/cosmeticCatalog/$(d.purchase)).data;
      let before = exists(/databases/$(database)/documents/accountWallets/$(uid)) ? get(/databases/$(database)/documents/accountWallets/$(uid)).data.balance : 0;
      return owner(uid) && d.keys().hasOnly(['balance','purchase'])
        && d.purchase is string && item.enabled == true && item.price is int && item.price >= 0
        && d.balance is int && d.balance >= 0 && d.balance == before - item.price
        && !exists(/databases/$(database)/documents/cosmeticOwners/$(uid)/items/$(d.purchase))
        && getAfter(/databases/$(database)/documents/cosmeticOwners/$(uid)/items/$(d.purchase)).data.item == d.purchase;
    }
    match /accountWallets/{uid} {
      allow create, update: if cosmeticPurchase(uid, request.resource.data);
    }
    match /cosmeticCatalog/{id} {
      allow get, list: if true;
      allow create, update: if launcherAdmin()
        && request.resource.data.keys().hasOnly(['kind','name','price','enabled','design','color','rarity'])
        && request.resource.data.kind in ['cape','wings','hat','halo','aura']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.price is int && request.resource.data.price >= 0 && request.resource.data.price <= 1000000
        && request.resource.data.enabled is bool
        && request.resource.data.design is int && request.resource.data.design >= 0 && request.resource.data.design <= 3
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.rarity in ['common','rare','epic','legendary'];
      allow delete: if false;
    }
    match /cosmeticOwners/{uid}/items/{id} {
      allow get, list: if owner(uid) || launcherAdmin();
      allow create: if request.resource.data.keys().hasOnly(['item']) && request.resource.data.item == id
        && (launcherAdmin() || (owner(uid)
          && getAfter(/databases/$(database)/documents/accountWallets/$(uid)).data.purchase == id
          && cosmeticPurchase(uid,getAfter(/databases/$(database)/documents/accountWallets/$(uid)).data)));
      allow update: if false;
      allow delete: if launcherAdmin();
    }
    function cosmeticSlot(uid, d, kind) {
      let id = d.get(kind, '');
      return (resource != null && d.get(kind, '') == resource.data.get(kind, '')) || id == '' || (exists(/databases/$(database)/documents/cosmeticOwners/$(uid)/items/$(id))
        && get(/databases/$(database)/documents/cosmeticCatalog/$(id)).data.kind == kind);
    }
    match /accountCosmetics/{nickname} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if owner(request.auth.uid)
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.nickname.lower() == nickname
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','cape','wings','hat','halo','aura'])
        && cosmeticSlot(request.auth.uid,request.resource.data,'cape')
        && cosmeticSlot(request.auth.uid,request.resource.data,'wings')
        && cosmeticSlot(request.auth.uid,request.resource.data,'hat')
        && cosmeticSlot(request.auth.uid,request.resource.data,'halo')
        && cosmeticSlot(request.auth.uid,request.resource.data,'aura');
    }
    match /supportTickets/{ticket} {
      allow get, list: if launcherAdmin() || owner(resource.data.uid);
      allow create: if owner(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid','nickname','subject','status'])
        && request.resource.data.nickname == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.nickname
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 100
        && request.resource.data.status == 'open';
      allow update: if launcherAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open','closed'];
      allow delete: if false;
      match /messages/{message} {
        allow get, list: if launcherAdmin() || owner(get(/databases/$(database)/documents/supportTickets/$(ticket)).data.uid);
        allow create: if request.resource.data.keys().hasOnly(['uid','admin','text','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 3000
          && ((launcherAdmin() && request.resource.data.admin == true)
            || (owner(get(/databases/$(database)/documents/supportTickets/$(ticket)).data.uid)
              && get(/databases/$(database)/documents/supportTickets/$(ticket)).data.status == 'open'
              && request.resource.data.admin == false));
        allow update, delete: if false;
      }
    }

    function playerNick() { return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.nickname.lower(); }
    function friendsWith(a,b) {
      return (exists(/databases/$(database)/documents/playerFriends/$(a+'~'+b)) && get(/databases/$(database)/documents/playerFriends/$(a+'~'+b)).data.status == 'accepted')
        || (exists(/databases/$(database)/documents/playerFriends/$(b+'~'+a)) && get(/databases/$(database)/documents/playerFriends/$(b+'~'+a)).data.status == 'accepted');
    }
    match /playerFriends/{id} {
      allow get, list: if request.auth != null && resource.data.from == playerNick();
      allow get, list: if request.auth != null && resource.data.to == playerNick();
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['from','to','status'])
        && request.resource.data.from == playerNick() && request.resource.data.to.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.to != playerNick() && id == request.resource.data.from+'~'+request.resource.data.to
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && playerNick() == resource.data.to
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null && (resource.data.from == playerNick() || resource.data.to == playerNick());
    }
    match /playerPresence/{nickname} {
      allow get: if request.auth != null && (playerNick() == nickname || friendsWith(playerNick(),nickname));
      allow create, update: if request.auth != null && playerNick() == nickname
        && request.resource.data.keys().hasOnly(['uid','pack','playing','updatedAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.pack is string
        && request.resource.data.pack.size() <= 100 && request.resource.data.playing is bool
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }
    match /playerInbox/{uid}/messages/{id} {
      allow get, list: if owner(uid) || launcherAdmin();
      allow create: if launcherAdmin() && request.resource.data.keys().hasOnly(['text','createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /accountWallets/{uid}/history/{id} { allow get, list: if owner(uid); }

    match /directPlayRequests/{id} {
      allow get, list: if request.auth != null && resource.data.host == playerNick();
      allow get, list: if request.auth != null && resource.data.guest == playerNick();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['host','guest','status','expires'])
        && request.resource.data.guest == playerNick()
        && request.resource.data.host.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.host != playerNick()
        && id == playerNick()+'~'+request.resource.data.host
        && friendsWith(playerNick(),request.resource.data.host)
        && request.resource.data.status == 'pending'
        && request.resource.data.expires is int
        && request.resource.data.expires > request.time.toMillis()
        && request.resource.data.expires <= request.time.toMillis()+360000;
      allow update: if request.auth != null && resource.data.host == playerNick()
        && friendsWith(playerNick(),resource.data.guest)
        && resource.data.status == 'pending' && resource.data.expires > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','token','endpoints'])
        && ((request.resource.data.status == 'declined' && request.resource.data.keys().hasOnly(['host','guest','status','expires']))
          || (request.resource.data.status == 'approved'
            && request.resource.data.keys().hasOnly(['host','guest','status','expires','token','endpoints'])
            && request.resource.data.token.matches('^[a-f0-9]{64}$')
            && request.resource.data.endpoints is string && request.resource.data.endpoints.size() <= 1024));
      allow delete: if request.auth != null && (resource.data.host == playerNick() || resource.data.guest == playerNick());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
